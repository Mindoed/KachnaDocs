# KachnaDocs environment configuration.
#
# Who reads it:
#   - The container: `docker run --env-file .env`, or `env_file: .env` in a
#     compose file. The image ships no defaults of its own, so everything under
#     "Required" has to come from here (or from the shell/proxying layer).
#   - Local dev instead reads apps/api/.env, a separate git-ignored file next to
#     the API source.
#

# ===========================================================================
# Required — the API refuses to boot or wont work without these
# ===========================================================================

# From the Discord Developer Portal, General Information page.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Session cookie secret (plan to not use in the future)
SESSION_SECRET=


# Needs to be set in the Discord Developer Portal, link:
# https://discord.com/developers/applications/855391573519892490/oauth2
DISCORD_CALLBACK_URL=/api/auth/discord/callback

# SU FIT Discord guild ID = 369526274433089546
DISCORD_GUILD_ID=369526274433089546

# ===========================================================================
# Deployment
# ===========================================================================

# Needed to set to "production" otherwise the API will not boot correctly.
NODE_ENV=production

# A site at https://example.com/kachnadocs/, empty for the origin root.
BASE_PATH=/kachnadocs

# If undefined api defaults to 3000
API_PORT=3000

# ===========================================================================
# Documents & collaboration (apps/collab + document endpoints)
# ===========================================================================

# PostgreSQL for documents, ACL and Yjs document states. Local dev instance:
#   docker compose -f infra/docker-compose.yml up -d
# Without it the API boots but every /api/documents route answers 503, and
# apps/collab refuses to start.
DATABASE_URL=postgresql://kachna:kachna@localhost:5432/kachnadocs

# HMAC secret for the short-lived, document-scoped collaboration JWTs the API
# signs and the collab server verifies. Both processes must see the SAME value.
# Generate: openssl rand -hex 32
COLLAB_JWT_SECRET=

# Read by the collab server (also settable in apps/collab/.env, which is what
# local dev uses). Defaults to 1234.
COLLAB_PORT=1234

# VITE_COLLAB_URL is a *build-time* variable for the web bundle (not read by
# the container): the WebSocket URL the browser dials, e.g.
#   ws://localhost:1234                      (dev)
#   wss://example.com/kachnadocs-collab      (prod, proxied to the collab server)
# Unset, the SPA falls back to ws://<current hostname>:1234.
# VITE_COLLAB_URL=
