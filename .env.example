# KachnaDocs environment configuration.
#
# Who reads it:
#   - The container: `docker run --env-file .env`, or `env_file: .env` in a
#     compose file. The image ships no defaults of its own, so everything under
#     "Required" has to come from here (or from the shell/proxying layer).
#   - Local dev instead reads apps/api/.env, a separate git-ignored file next to
#     the API source.
#

# ===========================================================================
# Required — the API refuses to boot without these
# ===========================================================================

# From the Discord Developer Portal, General Information page.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Session cookie secret (plan to not use in the future)
SESSION_SECRET=


# Needs to be set in the Discord Developer Portal, link:
# https://discord.com/developers/applications/855391573519892490/oauth2
DISCORD_CALLBACK_URL=/api/auth/discord/callback

# ===========================================================================
# Required at first login (not at boot)
# ===========================================================================

# SU FIT Discord guild ID = 369526274433089546
DISCORD_GUILD_ID=369526274433089546

# ===========================================================================
# Deployment
# ===========================================================================

# Needed to set to "production" otherwise the API will not boot correctly.
NODE_ENV=production
