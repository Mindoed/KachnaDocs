# KachnaDocs stack configuration for docker compose.
# Copy to .env in this same directory (git-ignored) and fill in. Compose reads
# that file when resolving the ${...} references in docker-compose.yml — see
# apps/api/.env.example for what each Discord variable means and where to get it.
#
# A variable exported in the shell outranks the file, so a one-off
# `SESSION_SECRET=... docker compose up` wins over a stale copy here.
#
# Values may be wrapped in matching single or double quotes (shown below);
# compose's dotenv parser strips them. Quotes are most useful when a value
# contains spaces, like DISCORD_SCOPES.

# From the Discord Developer Portal, General Information page.
# Required —  compose refuses to start without it.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# SU FIT Discord guild ID = 369526274433089546
DISCORD_GUILD_ID=369526274433089546

# Compose default assumes the local stack: web (nginx) on 8080 proxies /api to
# the api container, so the callback reaches Discord through that URL. Must
# match, character for character, a redirect URI registered in the portal.
#DISCORD_CALLBACK_URL="http://localhost:8080/api/auth/discord/callback"

# Space-separated OAuth2 scopes — quoted so the space can't be misread.
# See https://docs.discord.com/developers/topics/oauth2
#DISCORD_SCOPES="identify guilds"

# Portal "Web" application type must keep this false (client_secret auth).
#DISCORD_USE_PKCE="false"

# Required — compose refuses to start without it. Use a long random value,
# rotated when it may have leaked. Quote it if it contains spaces.
SESSION_SECRET=

# Origin the api accepts for CORS. Defaults to the local web container.
# If the SPA is served from another host in production, set this to it.
#FRONTEND_URL="http://localhost:8080"
