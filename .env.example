# KachnaDocs stack configuration for docker compose.
# Copy to .env in this same directory (git-ignored) and fill in. Compose reads
# that file when resolving the ${...} references in docker-compose.yml.
#
# The stack is ONE container now: nginx serves the SPA and proxies /api to the
# NestJS process on loopback beside it. Every variable below therefore belongs to
# the single `web` service — there is no separate api service to set them on.
#
# A variable exported in the shell outranks the file, so a one-off
# `SESSION_SECRET=... docker compose up` wins over a stale copy here.
#
# Values may be wrapped in matching single or double quotes (shown below);
# compose's dotenv parser strips them. Quotes are most useful when a value
# contains spaces, like DISCORD_SCOPES.
#
# For plain `npm run dev:api` / `dev:web` instead of Docker, the api reads its own
# git-ignored apps/api/.env. Vite proxies /api to http://localhost:3000, so in dev
# DISCORD_CALLBACK_URL there should be
#   http://localhost:5173/api/auth/discord/callback
# (that URI must also be registered in the Discord portal — the OAuth `state`
# lives in the session cookie, so the flow only works when start and callback
# share one origin).

# From the Discord Developer Portal, General Information page.
# Required —  compose refuses to start without it.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# SU FIT Discord guild ID = 369526274433089546
DISCORD_GUILD_ID=369526274433089546

# Compose default assumes the local stack: nginx on 8080 proxies /api to the API
# on loopback in the same container, so the callback reaches Discord through that
# URL. Must match, character for character, a redirect URI registered in the portal.
#DISCORD_CALLBACK_URL="http://localhost:8080/api/auth/discord/callback"

# Space-separated OAuth2 scopes — quoted so the space can't be misread.
# See https://docs.discord.com/developers/topics/oauth2
#DISCORD_SCOPES="identify guilds"

# Portal "Web" application type must keep this false (client_secret auth).
#DISCORD_USE_PKCE="false"

# Required — compose refuses to start without it. Use a long random value,
# rotated when it may have leaked. Quote it if it contains spaces.
SESSION_SECRET=

# The origin the browser sees. Defaults to the local container.
#
# This is load-bearing for login, not just CORS. The OAuth popup's final page is
# served by the api, and it signals the opener with
# postMessage(..., FRONTEND_URL) — apps/api/src/features/auth/auth.service.ts.
# That argument must match the popup origin exactly, scheme included, or the
# browser drops the message and the spinner on /auth never resolves.
#
# With nginx and the api sharing one container (and therefore one origin), the
# CORS half of this is inert; the postMessage half still has to be right.
#FRONTEND_URL="http://localhost:8080"
