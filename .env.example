# KachnaDocs backend configuration.
# Copy to .env in this same directory (git-ignored) and fill in. The server starts without
# these — /health then reports configured:false, and /login / /callback return
# a 503 naming the missing variables.
#
# Values here outrank nothing: a real process environment variable always wins
# over this file, so a deployed value is never shadowed by a stale local copy.

# From the Discord Developer Portal, General Information page.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Port the server listens on.
PORT=5173

# Must match, character for character, an OAuth2 redirect URI registered in the
# portal's OAuth2 page. A mismatch fails at Discord's consent screen with
# error 31013 before the request ever reaches us.
# Defaults to http://localhost:$PORT/callback
DISCORD_REDIRECT_URI=http://localhost:5173/callback

# Origin used to parse incoming request URLs. Set this to the public URL when
# deployed behind a proxy.
# PUBLIC_ORIGIN=http://localhost:5173

# Space-separated OAuth2 scopes. (More info here https://docs.discord.com/developers/topics/oauth2)
#   identify             -> /users/@me
#   guilds               -> /users/@me/guilds (servers the user is in)
#   guilds.members.read  -> member info per guild
#   email                -> /users/@me email fields
#   connections          -> /users/@me/connections (Twitch, Steam, ...)
DISCORD_SCOPES=identify guilds

# PKCE (code_challenge). A portal "Web" application type must keep this false
# and authenticate with client_secret. A non-web application type requires
# PKCE and must set this true.
DISCORD_USE_PKCE=false

DISCORD_GUILD_ID=369526274433089546