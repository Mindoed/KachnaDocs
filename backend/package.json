{
  "name": "kachnadocs-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KachnaDocs Discord OAuth2 identity backend. No persistence.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && node dist/server.js",
    "dev": "node --experimental-strip-types --watch src/server.ts"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "discord-api-types": "^0.38.56"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
