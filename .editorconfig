root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Source files: always 2 spaces, never tabs
[*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,css,scss,sass,less,styl}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{json,jsonc,json5,yaml,yml,html,xml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
