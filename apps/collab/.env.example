# Collaboration server (Hocuspocus) configuration.
# Copy to apps/collab/.env (git-ignored) and fill in.

# PostgreSQL — same database the API uses (the collab server reads the ACL and
# writes document_states.yjs_state there). Matches infra/docker-compose.yml.
DATABASE_URL=postgresql://kachna:kachna@localhost:5432/kachnadocs

# MUST equal COLLAB_JWT_SECRET in the API's environment (apps/api/.env in dev):
# the API signs collaboration tokens with it, this server only verifies them.
# Any long random string, e.g. `openssl rand -hex 32`.
COLLAB_JWT_SECRET=

# WebSocket port the SPA connects to (VITE_COLLAB_URL=ws://localhost:1234).
COLLAB_PORT=1234
